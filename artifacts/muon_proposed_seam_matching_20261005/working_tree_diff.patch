+    assert np.any(fields['auxiliary_source_lifting']==0)
+    assert guards['full_same_source_stationary_return_evaluated'] is False
+    assert 'unevaluated' in identity['full_physical_same_photon_vertex']
+    ratio=float(c['auxiliary_photon_ratio'].mid())
