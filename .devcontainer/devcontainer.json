{
  "name": "BHSM institutional review",
  "build": {"dockerfile": "../integrations/institutional/Dockerfile", "context": ".."},
  "postCreateCommand": "python -m pip install -e . && python tools/institutional_check.py",
  "remoteEnv": {
    "WOLFRAMSCRIPT_PATH": "${localEnv:WOLFRAMSCRIPT_PATH}",
    "WOLFRAM_KERNEL_PATH": "${localEnv:WOLFRAM_KERNEL_PATH}",
    "MATHEMATICA_PATH": "${localEnv:MATHEMATICA_PATH}",
    "FEYNRULES_PATH": "${localEnv:FEYNRULES_PATH}",
    "MADGRAPH_PATH": "${localEnv:MADGRAPH_PATH}",
    "MG5AMC_PATH": "${localEnv:MG5AMC_PATH}"
  },
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-toolsai.jupyter"]}}
}
